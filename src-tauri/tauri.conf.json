{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "补水啦",
  "version": "0.1.0",
  "identifier": "com.bushuila.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420/?v=2",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "补水啦",
        "width": 160,
        "height": 200,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: asset: http://asset.localhost; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/pets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
